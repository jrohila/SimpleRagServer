<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.jrohila</groupId>
    <artifactId>simple-rag-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>SimpleRagParent</name>
    <description>Aggregator for SimpleRag multi-module build</description>

    <properties>
        <micronaut.version>4.7.6</micronaut.version>
        <micronaut.runtime>netty</micronaut.runtime>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <testResourcesVersion>2.6.2</testResourcesVersion>
        <micronaut.test.resources.enabled>false</micronaut.test.resources.enabled>
        <opennlp.version>1.9.4</opennlp.version>
        <opennlp.models.version>1.3.0</opennlp.models.version>
        <node.version>v25.1.0</node.version>
        <npm.version>11.6.2</npm.version>
        <!-- OpenNLP model paths (module builds can override via profiles) -->
        <nlp.sent-model-path>/models/sentences/opennlp-en-ud-ewt-sentence-1.3-2.5.4.bin</nlp.sent-model-path>
        <nlp.pos-model-path>/models/pos/opennlp-en-ud-ewt-pos-1.3-2.5.4.bin</nlp.pos-model-path>
        <nlp.lang-model>/models/lang/langdetect-183.bin</nlp.lang-model>
        
        <!-- How model paths should be interpreted: 'classpath' or 'filesystem' or 'auto' -->
        <nlp.model.path.type>classpath</nlp.model.path.type>
    </properties>

    <modules>
        <module>simple-rag-ui</module>
        <module>simple-rag-data</module>
        <module>simple-rag-server</module>
    </modules>
    
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.micronaut.platform</groupId>
                <artifactId>micronaut-platform</artifactId>
                <version>${micronaut.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    
    <profiles>
        <profile>
            <id>graalvm-dev</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <properties>
                <!-- default native image name; child POMs may override or use this -->
                <graalvm.native.image.name>${project.artifactId}</graalvm.native.image.name>
                <!-- Native image / Docker resource destinations (overrideable) -->
                <native.exploded.dir>/workspace/exploded</native.exploded.dir>
                <native.models.dest>/app/models</native.models.dest>
                <nlp.model.path.type>filesystem</nlp.model.path.type>
                <!-- Override NLP model classpath/filesystem locations for graal native builds (files copied to /app/models) -->
                <nlp.sent-model-path>/app/models/sentences/opennlp-en-ud-ewt-sentence-1.3-2.5.4.bin</nlp.sent-model-path>
                <nlp.pos-model-path>/app/models/pos/opennlp-en-ud-ewt-pos-1.3-2.5.4.bin</nlp.pos-model-path>
                <nlp.lang-model>/app/models/lang/langdetect-183.bin</nlp.lang-model>
                <native.binary.source>/workspace/simple-rag-server-native</native.binary.source>
                <native.binary.dest>/app/simple-rag-server</native.binary.dest>
                <!-- Docker development URLs (host.docker.internal) -->
                <opensearch.uris>http://host.docker.internal:9200</opensearch.uris>
                <docling.serve.url>http://host.docker.internal:5001</docling.serve.url>
                <llm.ollama.baseUrl>http://host.docker.internal:11434</llm.ollama.baseUrl>
                <opensearch.username>admin</opensearch.username>
                <opensearch.password>MyAdm1n_Passw0rd!</opensearch.password>
            </properties>
            <!-- Build plugins removed - native image built in Docker container -->
        </profile>
        
        <profile>
            <id>standard-build</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <!-- Standard (non-Graal) build -->
                <graalvm.enabled>false</graalvm.enabled>
                <nlp.model.path.type>classpath</nlp.model.path.type>
                <!-- Local development URLs (localhost) -->
                <opensearch.uris>http://localhost:9200</opensearch.uris>
                <docling.serve.url>http://localhost:5001</docling.serve.url>
                <llm.ollama.baseUrl>http://localhost:11434</llm.ollama.baseUrl>
                <opensearch.username>admin</opensearch.username>
                <opensearch.password>MyAdm1n_Passw0rd!</opensearch.password>
            </properties>
        </profile>
        
        <profile>
            <id>graalvm-prod</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <properties>
                <!-- For future cloud deployment - uses environment variables -->
                <graalvm.native.image.name>${project.artifactId}</graalvm.native.image.name>
                <native.exploded.dir>/workspace/exploded</native.exploded.dir>
                <native.models.dest>/app/models</native.models.dest>
                <nlp.model.path.type>filesystem</nlp.model.path.type>
                <nlp.sent-model-path>/app/models/sentences/opennlp-en-ud-ewt-sentence-1.3-2.5.4.bin</nlp.sent-model-path>
                <nlp.pos-model-path>/app/models/pos/opennlp-en-ud-ewt-pos-1.3-2.5.4.bin</nlp.pos-model-path>
                <nlp.lang-model>/app/models/lang/langdetect-183.bin</nlp.lang-model>
                <native.binary.source>/workspace/simple-rag-server-native</native.binary.source>
                <native.binary.dest>/app/simple-rag-server</native.binary.dest>
                <!-- Cloud deployment URLs (runtime environment variables) -->
                <opensearch.uris>${OPENSEARCH_URIS}</opensearch.uris>
                <docling.serve.url>${DOCLING_SERVE_URL}</docling.serve.url>
                <llm.ollama.baseUrl>${LLM_OLLAMA_BASE_URL}</llm.ollama.baseUrl>
            </properties>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>org.codehaus.mojo</groupId>
                            <artifactId>exec-maven-plugin</artifactId>
                            <version>3.1.0</version>
                            <executions>
                                <execution>
                                    <id>native-image</id>
                                    <phase>package</phase>
                                    <goals>
                                        <goal>exec</goal>
                                    </goals>
                                    <configuration>
                                        <executable>native-image</executable>
                                        <arguments>
                                            <argument>--no-fallback</argument>
                                            <argument>-jar</argument>
                                            <argument>${project.build.directory}/${project.build.finalName}.jar</argument>
                                            <argument>-H:Name=${graalvm.native.image.name}</argument>
                                        </arguments>
                                    </configuration>
                                </execution>
                            </executions>
                        </plugin>
                    </plugins>
                </pluginManagement>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>build-native-image</id>
                                <goals>
                                    <goal>build</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>${graalvm.native.image.name}</imageName>
                            <buildArgs>
                                <arg>--no-fallback</arg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>io.micronaut.maven</groupId>
                    <artifactId>micronaut-maven-plugin</artifactId>
                    <version>4.7.1</version>
                    <configuration>
                        <testResourcesVersion>${testResourcesVersion}</testResourcesVersion>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
